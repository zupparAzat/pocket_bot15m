    print(f"Без торгового плана:          {diagnostics['no_plan']}")
    print(f"Отсеяно по отклонению цены:   {diagnostics['price_rejected']}")
    print(f"Стоп/тейк не с той стороны:   {diagnostics['invalid_position']}")
    print(f"R:R ниже 1.3:                 {diagnostics['low_rr']}")
    print(f"Другие невалидные планы:      {diagnostics['other_invalid']}")
    print(f"Отклонено по ATR:             {diagnostics['risk_atr_rejected']}")

    print("\nПО НАПРАВЛЕНИЯМ")
    for side in ("long", "short"):
        group = [t for t in trades if t["action"] == side]
        if not group:
            continue

        pnl = sum(t["pips"] for t in group)
        wins = sum(t["result"] == "win" for t in group)

        print(
            f"{side.upper()}: {len(group)} сделок, "
            f"тейков {wins}, P&L {pnl:+.1f} пипса"
        )

    print("\nПО SCORE")
    for low, high in ((0, 64), (65, 79), (80, 89), (90, 100)):
        group = [t for t in trades if low <= t["score"] <= high]
        if not group:
            continue

        pnl = sum(t["pips"] for t in group)
        wins = sum(t["result"] == "win" for t in group)

        print(
            f"{low}-{high}: {len(group)} сделок, "
            f"тейков {wins}, P&L {pnl:+.1f} пипса"
        )


if __name__ == "__main__":
    asyncio.run(main())